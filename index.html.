<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Human Seasons — Animation</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: #000;
    overflow: hidden;
    font-family: Georgia, 'Times New Roman', serif;
    color: #fff;
    user-select: none;
  }
  #stage {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  #caption {
    position: absolute;
    bottom: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 82%;
    text-align: center;
    font-size: 1.5rem;
    font-style: italic;
    letter-spacing: 0.05em;
    text-shadow: 0 0 24px rgba(0,0,0,0.95), 0 0 6px rgba(0,0,0,1);
    opacity: 0;
    transition: opacity 1.6s ease;
    pointer-events: none;
    line-height: 1.5;
  }
  #caption.show { opacity: 1; }
  #lineNum {
    position: absolute;
    top: 4%;
    right: 5%;
    font-size: 0.85rem;
    opacity: 0.45;
    letter-spacing: 0.25em;
    font-variant: small-caps;
  }
  #controls {
    position: absolute;
    top: 4%;
    left: 5%;
    font-size: 0.75rem;
    opacity: 0.55;
    letter-spacing: 0.1em;
  }
  button {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.35);
    color: #fff;
    padding: 7px 14px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-right: 6px;
    transition: all 0.25s ease;
    backdrop-filter: blur(6px);
  }
  button:hover {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.7);
  }
  #muteBtn { margin-left: 12px; }
  #finalLines {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2.5vh;
  text-align: center;
  pointer-events: none;
  opacity: 0;
  transition: opacity 3s ease;
  z-index: 100;
  padding: 0 8vw;
}

#finalLines.show {
  opacity: 1;
}

#finalLines .final-line {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: clamp(1.8rem, 4vw, 3.4rem);
  line-height: 1.35;
  color: #1a1a22;
  letter-spacing: 0.02em;
  transform: translateY(20px);
  opacity: 0;
  transition: transform 2.5s ease, opacity 2.5s ease;
  text-shadow: 0 0 2px rgba(0,0,0,0.05);
}

#finalLines.show .final-line {
  transform: translateY(0);
  opacity: 1;
}

#finalLines.show .final-line:nth-child(1) {
  transition-delay: 0.6s;
}

#finalLines.show .final-line:nth-child(2) {
  transition-delay: 1.6s;
}
#credits {
  position: absolute;
  bottom: 6%;
  left: 50%;
  transform: translateX(-50%) translateY(15px);
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: clamp(0.9rem, 1.4vw, 1.2rem);
  letter-spacing: 0.25em;
  color: rgba(40, 40, 55, 0.7);
  opacity: 0;
  transition: opacity 3s ease, transform 3s ease;
  pointer-events: none;
  z-index: 101;
  text-align: center;
}

#credits.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
</style>
</head>
<body>
<div id="stage">
  <canvas id="scene"></canvas>
  <div id="caption"></div>
  <div id="lineNum">I / XIV</div>
   <div id="finalLines">
      <div id="credits">
    Made by Ivan Lukinsky
  </div>
    <div class="final-line">Or else he would forego his mortal nature.</div>
  </div>
  <div id="controls">
    <button id="btnPlay">▶ Play</button>
    <button id="btnNext">⏭ Next</button>
